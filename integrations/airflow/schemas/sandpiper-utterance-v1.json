{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.quantumlearningmachines.com/schemas/sandpiper-utterance-v1.json",
  "title": "QLM Sandpiper utterance import event, version 1",
  "description": "An importer's observation of one utterance row from a Sandpiper (National Tutoring Observatory) PER_UTTERANCE utterances CSV. The utterance is an observed dialogue turn. Annotation codes are inferred assertions by a named annotator, never observations of help, and every assistance stage is not_recorded. Actor is the importer; the historical speaker stays in utterance.role. Source times stay unparsed strings. Integrity bindings do not establish semantic validity.",
  "type": "object",
  "required": [
    "name",
    "salt",
    "data",
    "activity",
    "actor"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "const": "qlm_import:transcript_utterance_observed"
    },
    "salt": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "object",
      "required": [
        "role",
        "kind",
        "id"
      ],
      "properties": {
        "role": {
          "const": "system"
        },
        "kind": {
          "const": "software"
        },
        "id": {
          "const": "QLM-transformer"
        }
      },
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "provenance",
        "time_basis",
        "source_time_basis",
        "original_source_timestamp",
        "utterance",
        "inferred_annotations",
        "assistance",
        "assistance_stages",
        "raw_source_fields",
        "reported_metrics",
        "missing_metrics",
        "assistance_context"
      ],
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "type": "object",
          "required": [
            "platform",
            "source_sha256",
            "source_row",
            "source_record_sha256",
            "imported_at",
            "mapping_sha256",
            "source_kind"
          ],
          "additionalProperties": false,
          "properties": {
            "platform": {
              "const": "sandpiper"
            },
            "source_sha256": {
              "$ref": "#/$defs/hash"
            },
            "source_record_sha256": {
              "$ref": "#/$defs/hash"
            },
            "mapping_sha256": {
              "$ref": "#/$defs/hash"
            },
            "source_row": {
              "type": "integer",
              "minimum": 1
            },
            "imported_at": {
              "type": "string",
              "format": "date-time"
            },
            "source_kind": {
              "enum": [
                "synthetic_fixture",
                "unverified_user_input"
              ]
            }
          }
        },
        "time_basis": {
          "const": "import_time"
        },
        "source_time_basis": {
          "const": "source_strings_unparsed"
        },
        "original_source_timestamp": {
          "type": "null"
        },
        "utterance": {
          "type": "object",
          "required": [
            "_id",
            "session_id",
            "sequence_id",
            "role",
            "content",
            "start_time",
            "end_time"
          ],
          "additionalProperties": false,
          "properties": {
            "_id": {
              "type": "string"
            },
            "session_id": {
              "type": "string",
              "minLength": 1
            },
            "sequence_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "content": {
              "type": "string"
            },
            "start_time": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "end_time": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        },
        "inferred_annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inferred_annotation"
          }
        },
        "assistance": {
          "const": "utterance_recorded_no_help_stage"
        },
        "assistance_stages": {
          "type": "object",
          "required": [
            "requested",
            "offered",
            "generated",
            "transmitted",
            "displayed",
            "accepted"
          ],
          "additionalProperties": false,
          "properties": {
            "requested": {
              "const": "not_recorded"
            },
            "offered": {
              "const": "not_recorded"
            },
            "generated": {
              "const": "not_recorded"
            },
            "transmitted": {
              "const": "not_recorded"
            },
            "displayed": {
              "const": "not_recorded"
            },
            "accepted": {
              "const": "not_recorded"
            }
          }
        },
        "raw_source_fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "reported_metrics": {
          "type": "object",
          "maxProperties": 0
        },
        "missing_metrics": {
          "type": "array",
          "maxItems": 0
        },
        "assistance_context": {
          "type": "object",
          "required": [
            "phase",
            "permission",
            "observed_use",
            "capture",
            "capture_boundary",
            "product_version",
            "model_version"
          ],
          "additionalProperties": false,
          "properties": {
            "phase": {
              "enum": [
                "practice",
                "assessment",
                "other",
                "unknown"
              ]
            },
            "permission": {
              "enum": [
                "permitted",
                "prohibited",
                "restricted",
                "unknown"
              ]
            },
            "observed_use": {
              "enum": [
                "recorded",
                "not_recorded",
                "unknown"
              ]
            },
            "capture": {
              "enum": [
                "complete_within_boundary",
                "partial",
                "unknown"
              ]
            },
            "capture_boundary": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 2000
            },
            "product_version": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 2000
            },
            "model_version": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "capture": {
                    "const": "complete_within_boundary"
                  }
                }
              },
              "then": {
                "properties": {
                  "capture_boundary": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inferred_annotation": {
      "type": "object",
      "required": [
        "basis",
        "annotator",
        "index",
        "fields"
      ],
      "additionalProperties": false,
      "description": "A code an annotator (a model or a person; not established unless identifiedBy says so) assigned to the utterance. Derived, not observed; it sets no help stage.",
      "properties": {
        "basis": {
          "const": "inferred"
        },
        "annotator": {
          "type": "string",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "minLength": 1,
            "not": {
              "const": "identifiedBy"
            }
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "identifiedBy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
