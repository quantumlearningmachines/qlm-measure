{
  "name": "qlm-measure",
  "version": "0.4.1",
  "description": "Open measurement SDK for education AI \u2014 evidence events, record verification, and dataset clients",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "import": "./dist/schema/index.js",
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./emitter": {
      "import": "./dist/emitter/index.js",
      "types": "./dist/emitter/index.d.ts",
      "default": "./dist/emitter/index.js"
    },
    "./verifier": {
      "import": "./dist/verifier/index.js",
      "types": "./dist/verifier/index.d.ts",
      "default": "./dist/verifier/index.js"
    },
    "./clients": {
      "import": "./dist/clients/index.js",
      "types": "./dist/clients/index.d.ts",
      "default": "./dist/clients/index.js"
    },
    "./schemes": {
      "import": "./dist/schemes/index.js",
      "types": "./dist/schemes/index.d.ts",
      "default": "./dist/schemes/index.js"
    },
    "./schemes/node": {
      "import": "./dist/schemes/node.js",
      "types": "./dist/schemes/node.d.ts",
      "default": "./dist/schemes/node.js"
    }
  },
  "bin": {
    "qlm-measure": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && python3 tools/stamp-page-hash.py",
    "postbuild": "chmod +x dist/cli.js 2>/dev/null || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/quantumlearningmachines/qlm-measure"
  },
  "keywords": [
    "education",
    "measurement",
    "evidence",
    "learning-analytics",
    "misconceptions",
    "open-education"
  ],
  "author": "Quantum Learning Machines",
  "homepage": "https://play.quantumlearningmachines.com/developer"
}
